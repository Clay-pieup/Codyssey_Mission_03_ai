# 이 파일은 "키를 어떤 이름으로 적어야 하는지" 보여 주는 견본이다. (GitHub에 올라감)
# 사용법: 이 파일을 복사해 이름을 .env 로 바꾸고, = 뒤에 실제 값을 붙여 넣는다.
# .env 는 .gitignore 에 등록돼 있어 GitHub에 올라가지 않는다.
# = 앞뒤에 띄어쓰기나 따옴표를 넣지 않는다.

# 네이버 검색광고 API (U1-a: 키워드별 최근 30일 실제 검색수)
# 발급: searchad.naver.com → 광고플랫폼 → 도구 → API 사용 관리
SEARCHAD_CUSTOMER_ID=
SEARCHAD_ACCESS_LICENSE=
SEARCHAD_SECRET_KEY=

# NAVER API HUB 데이터랩 검색어트렌드 (U1-b: 일간 검색 지수) — A3-01과 같은 키
NAVER_API_KEY_ID=
NAVER_API_KEY=
